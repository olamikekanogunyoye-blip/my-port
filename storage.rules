rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "olamilekanogunyoye@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /{allPaths=**} {
      // Public read for all portfolio visual and audio assets
      allow read: if true;
      // Write and delete strictly reserved for verified owner
      allow write, delete: if isOwner();
    }
  }
}
